// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "indent_guides": {},
  "when_closing_with_no_tabs": "keep_window_open",
  "double_click_in_multibuffer": "select",
  "excerpt_context_lines": 10,
  "expand_excerpt_lines": 100,
  "show_edit_predictions": false,
  "preview_tabs": {},
  "vertical_scroll_margin": 1.0,
  "scrollbar": {
    "git_diff": true,
    "cursors": true,
    "show": "always",
    "track": "track",
  },
  "gutter": {
    "folds": false,
    "min_line_number_digits": 4,
    "bookmarks": false,
    "breakpoints": false,
    "git_gutter_width": {
      "custom": 16.0,
    },
  },
  "git": {
    "hunk_style": "unstaged_hollow",
    "show_stage_restore_buttons": false,
  },
  "context_servers": {
    "filesystem": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-filesystem", "/"],
    },
  },
  "terminal": {
    "show_count_badge": false,
  },
  "completions": {
    "words": "fallback",
    "suggest_selection": "recently_used",
  },
  "auto_signature_help": false,
  "show_signature_help_after_edits": true,
  "format_on_save": "modifications_if_available",
  "completion_menu_item_kind": "icon",
  "tabs": {
    "show_close_button": "always",
    "show_diagnostics": "all",
    "file_icons": true,
    "git_status": true,
    "show_full_tab_titles": true,
  },
  "diagnostics": {
    "button": true,
  },
  "status_bar": {
    "line_endings_button": true,
  },
  "diff_view_style": "split",
  "minimum_split_diff_width": 0,
  "hover_popover_hiding_delay": 400,
  "hover_popover_delay": 400,
  "agent_ui_font_size": 20.0,
  "agent_buffer_font_size": 16.0,
  "scroll_sensitivity": 1.0,
  "title_bar": {
    "show_menus": false,
    "show_user_menu": true,
    "show_sign_in": false,
    "show_branch_status_icon": false,
  },
  "tab_bar": {
    "show_pinned_tabs_in_separate_row": true,
    "show_nav_history_buttons": false,
  },
  "icon_theme": {
    "mode": "light",
    "light": "Material Icon Theme",
    "dark": "Material Icon Theme",
  },
  "language_models": {
    "opencode": {
      "show_zen_models": false,
      "available_models": [
        {
          "name": "deepseek-v4-flash-vision-exp",
          "display_name": "DeepSeek V4 Flash Vision",
          "max_tokens": 1000000,
          "max_output_tokens": 384000,
          "protocol": "openai_chat",
          "interleaved_reasoning": false,
          "reasoning_effort_levels": ["none", "low", "high", "max"],
          "subscription": "go",
        },
      ],
    },
  },
  "toolbar": {
    "agent_review": false,
    "selections_menu": false,
    "quick_actions": false,
    "breadcrumbs": false,
  },
  "minimap": {
    "thumb": "hover",
    "display_in": "active_editor",
    "show": "always",
  },
  "hide_mouse": "never",
  "auto_update": false,
  "lsp_results_location": "picker",
  "bottom_dock_layout": "contained",
  "outline_panel": {
    "button": false,
  },
  "show_whitespaces": "boundary",
  "git_panel": {
    "scrollbar": {},
    "file_icons": true,
    "group_by": "staging",
    "tree_view": true,
    "dock": "left",
    "entry_primary_click_action": "file_diff",
    "diff_stats": false,
    "status_style": "label_color",
    "message_editor_min_lines": 2,
  },
  "project_panel": {
    "default_width": 320.0,
    "folder_indicator": "both",
    "scrollbar": {
      "show": "auto",
    },
    "auto_fold_dirs": false,
    "entry_spacing": "comfortable",
    "hide_root": false,
    "sticky_scroll": false,
    "dock": "left",
  },
  "proxy": "",
  "agent_servers": {},
  "agent": {
    "default_width": 420.0,
    "expand_edit_card": false,
    "flexible": false,
    "show_turn_stats": false,
    "message_editor_min_lines": 2,
    "single_file_review": false,
    "expand_terminal_card": false,
    "enable_feedback": false,
    "thinking_display": "auto",
    "tool_permissions": {
      "tools": {
        "write_file": {
          "default": "allow",
        },
        "edit_file": {
          "default": "allow",
        },
        "mcp:filesystem:read_text_file": { "default": "allow" },
        "mcp:filesystem:read_multiple_files": { "default": "allow" },
        "mcp:filesystem:list_directory": { "default": "allow" },
        "mcp:filesystem:search_files": { "default": "allow" },
        "mcp:filesystem:directory_tree": { "default": "allow" },
        "mcp:filesystem:get_file_info": { "default": "allow" },
        "mcp:filesystem:list_allowed_directories": { "default": "allow" },
        "mcp:filesystem:list_directory_with_sizes": { "default": "allow" },
        "mcp:filesystem:write_file": { "default": "confirm" },
        "mcp:filesystem:edit_file": { "default": "confirm" },
        "mcp:filesystem:create_directory": { "default": "confirm" },
        "mcp:filesystem:move_file": { "default": "confirm" },
        "terminal": {
          "always_allow": [
            {
              "pattern": "^grep\\b",
            },
            {
              "pattern": "^head\\b",
            },
            {
              "pattern": "^echo\\b",
            },
            {
              "pattern": "^tail\\b",
            },
            {
              "pattern": "^ls\\b",
            },
            {
              "pattern": "^date\\s+\\+%Y-%m-%d(\\s|$)",
            },
            {
              "pattern": "^wc\\b",
            },
            {
              "pattern": "^cat\\b",
            },
            {
              "pattern": "^sort\\b",
            },
            {
              "pattern": "^uniq\\b",
            },
            {
              "pattern": "^sed\\b",
            },
            {
              "pattern": "^du\\b",
            },
            {
              "pattern": "^pgrep\\b",
            },
            {
              "pattern": "^stat\\b",
            },
            {
              "pattern": "^find\\b",
            },
            {
              "pattern": "^strings\\b",
            },
          ],
        },
        "search_web": {
          "default": "allow",
        },
        "fetch": {
          "default": "allow",
          "always_allow": [
            {
              "pattern": "^https?://skills\\.sh",
            },
            {
              "pattern": "^https?://raw\\.githubusercontent\\.com",
            },
            {
              "pattern": "^https?://api\\.github\\.com",
            },
          ],
        },
      },
    },
    "default_profile": "write",
    "profiles": {
      "write": {
        "default_model": {
          "provider": "opencode",
          "model": "go/deepseek-v4-flash",
          "enable_thinking": true,
          "effort": "max",
        },
        "name": "Write",
        "tools": {
          "copy_path": true,
          "create_directory": true,
          "create_thread": true,
          "delete_path": true,
          "diagnostics": true,
          "apply_code_action": true,
          "ask_user": true,
          "edit_file": true,
          "write_file": true,
          "fetch": true,
          "find_path": true,
          "find_references": true,
          "get_code_actions": true,
          "go_to_definition": true,
          "list_agents_and_models": true,
          "list_directory": true,
          "move_path": true,
          "rename_symbol": true,
          "read_file": true,
          "grep": true,
          "skill": true,
          "spawn_agent": true,
          "terminal": true,
          "search_web": true,
        },
        "enable_all_context_servers": true,
        "context_servers": {},
      },
      "ask": {
        "name": "Ask",
        "tools": {
          "terminal": true,
          "delete_path": false,
          "create_directory": false,
          "copy_path": false,
          "ask_user": true,
        },
        "enable_all_context_servers": false,
        "context_servers": {
          "filesystem": {
            "tools": {
              "write_file": false,
              "search_files": true,
              "read_text_file": true,
              "read_multiple_files": true,
              "read_media_file": true,
              "read_file": true,
              "list_directory_with_sizes": true,
              "list_directory": true,
              "list_allowed_directories": true,
              "get_file_info": true,
              "edit_file": false,
              "directory_tree": true,
              "create_directory": false,
            },
          },
        },
        "default_model": {
          "provider": "opencode",
          "model": "go/deepseek-v4-flash",
          "enable_thinking": true,
          "effort": "max",
        },
      },
    },
    "sandbox_permissions": {
      "allow_unsandboxed": true,
      "network_hosts": ["*.npmjs.org"],
    },
    "default_model": {
      "effort": "high",
      "provider": "opencode",
      "model": "go/deepseek-v4-flash",
      "enable_thinking": true,
    },
    "sidebar_side": "right",
    "auto_compact": {
      "threshold": "90%",
    },
    "dock": "right",
    "favorite_models": [
      {
        "provider": "opencode",
        "model": "go/deepseek-v4-flash",
        "enable_thinking": true,
        "effort": "high",
      },
      {
        "provider": "opencode",
        "model": "go/kimi-k3",
        "enable_thinking": true,
        "effort": "max",
      },
      {
        "provider": "opencode",
        "model": "go/deepseek-v4-pro",
        "enable_thinking": true,
        "effort": "high",
      },
      {
        "provider": "opencode",
        "model": "go/minimax-m3",
        "enable_thinking": false,
      },
      {
        "provider": "opencode",
        "model": "go/glm-5.2",
        "enable_thinking": true,
        "effort": "max",
      },
    ],
    "model_parameters": [],
  },
  "telemetry": {
    "diagnostics": true,
    "metrics": false,
    "anthropic_retention": false,
  },
  "base_keymap": "VSCode",
  "ui_font_size": 20.0,
  "buffer_font_size": 16.0,
  "theme": {
    "mode": "dark",
    "light": "One Light",
    "dark": "Ayu Dark",
  },
}
